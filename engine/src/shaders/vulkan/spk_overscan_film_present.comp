#version 450
#extension GL_GOOGLE_include_directive : require

// ④ (overscan.metal spk_overscan_film_present): where there is no film -- the
// perforations, and outside the strip -- the negative's density goes to the
// cmy that cancels this film's base, so the enlarger or scanner sees clear
// light.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Cmy { float value[]; } cmy;
layout(set = 0, binding = 1, std430) readonly buffer Parameters { float value[]; } p_data;
layout(set = 0, binding = 2, std430) readonly buffer Count { uint value[]; } count_data;
layout(set = 0, binding = 3, std430) writeonly buffer Output { float value[]; } output_data;

#include "spk_overscan_common.glsl"

void main() {
    uint i = spk_global_index();
    if (i >= count_data.value[0]) return;
    uint cw = uint(P(P_CW));
    float a = film_alpha(canvas_to_film(float(i % cw), float(i / cw)));
    vec3 c = vec3(cmy.value[3u * i], cmy.value[3u * i + 1u], cmy.value[3u * i + 2u]);
    vec3 hole = vec3(P(P_HOLE_C), P(P_HOLE_M), P(P_HOLE_Y));
    vec3 r3 = a * c + (1.0 - a) * hole;
    output_data.value[3u * i] = r3.x;
    output_data.value[3u * i + 1u] = r3.y;
    output_data.value[3u * i + 2u] = r3.z;
}
