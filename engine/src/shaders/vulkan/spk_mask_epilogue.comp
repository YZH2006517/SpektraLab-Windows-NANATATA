#version 450
#extension GL_GOOGLE_include_directive : require

// RFC-024's application (contrast_mask.metal spk_mask_epilogue): the print's
// spectral integral with the mask's gain on the image exposure before the
// pre-flash is added. `row0` is the band's first row in the frame, so a strip
// samples the field exactly where the whole-frame render does. The base is
// `a * x + b` with `(a, b)` sampled bilinearly from the grid.
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Cmy { float value[]; } cmy_data;
layout(set = 0, binding = 1, std430) readonly buffer Chd { float value[]; } chd_data;
layout(set = 0, binding = 2, std430) readonly buffer Base { float value[]; } base_data;
layout(set = 0, binding = 3, std430) readonly buffer Ixs { float value[]; } ixs_data;
layout(set = 0, binding = 4, std430) readonly buffer Parameters { float value[]; } p_data;
layout(set = 0, binding = 5, std430) readonly buffer Coefficients { float value[]; } coef;
layout(set = 0, binding = 6, std430) readonly buffer Meta { uint value[]; } meta;
layout(set = 0, binding = 7, std430) writeonly buffer Output { float value[]; } output_data;

#include "spk_mask_common.glsl"

vec2 coefficient(uint cell) { return vec2(coef.value[2u * cell], coef.value[2u * cell + 1u]); }

void main() {
    uint n = meta.value[0], nl = meta.value[1], W = meta.value[2], H = meta.value[3];
    uint row0 = meta.value[4], gw = meta.value[5], gh = meta.value[6];
    uint i = spk_global_index();
    if (i >= n) return;
    vec3 a = mask_image_exposure(i, nl);

    uint px = i % W, py = row0 + i / W;
    float u = clamp((float(px) + 0.5) * float(gw) / float(W) - 0.5, 0.0, float(gw - 1u));
    float v = clamp((float(py) + 0.5) * float(gh) / float(H) - 0.5, 0.0, float(gh - 1u));
    uint u0 = uint(floor(u)), v0 = uint(floor(v));
    uint u1 = min(u0 + 1u, gw - 1u), v1 = min(v0 + 1u, gh - 1u);
    float tu = u - float(u0), tv = v - float(v0);
    vec2 ab = mix(mix(coefficient(v0 * gw + u0), coefficient(v0 * gw + u1), tu),
                  mix(coefficient(v1 * gw + u0), coefficient(v1 * gw + u1), tu), tv);

    float b = ab.x * mask_x(a) + ab.y;
    float k = exp2(mask_delta(b));
    for (uint c = 0u; c < 3u; ++c) {
        float e = max(k * a[c] + p_data.value[6u + c], 0.0) + 1e-10;
        output_data.value[3u * i + c] = log(e) * 0.4342944819032518;
    }
}
